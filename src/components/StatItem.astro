---
/** A figure that is never shown without the context explaining what it does and does not mean. */
interface Props {
  value: string;
  label: string;
  context: string;
  href?: string;
  linkLabel?: string;
  /** For use on the deep teal background. */
  inverse?: boolean;
}

const { value, label, context, href, linkLabel, inverse = false } = Astro.props;
---

<div class:list={['stat', { 'stat--inverse': inverse }]}>
  <p class="figure">
    <span class="value">{value}</span>
    <span class="label">{label}</span>
  </p>
  <p class="context">{context}</p>
  {
    href && linkLabel && (
      <a class="text-link" href={href}>
        {linkLabel} <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    )
  }
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 1.25rem;
    border-left: 4px solid var(--color-coral);
  }

  .figure {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .value {
    color: var(--color-deep);
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .label {
    color: var(--color-deep);
    font-weight: 650;
  }

  .context {
    max-width: 30rem;
    color: var(--color-muted);
    font-size: 0.9688rem;
  }

  .text-link {
    font-size: 0.9688rem;
  }

  .stat--inverse {
    gap: 0.8rem;
    padding-left: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .stat--inverse .value {
    color: var(--color-coral);
    font-size: clamp(2.75rem, 2rem + 2.6vw, 3.875rem);
    white-space: nowrap;
  }

  .stat--inverse .label {
    color: #fff;
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  .stat--inverse .context {
    color: #c9dad8;
    font-size: 1rem;
  }

  .stat--inverse .text-link {
    color: #f8c0b4;
  }

  .stat--inverse .text-link:hover {
    color: #fff;
  }

  .stat--inverse :focus-visible {
    outline-color: #fff;
  }
</style>
