---
import { Image } from 'astro:assets';
import PlaceholderMedia from './PlaceholderMedia.astro';
import { articleUrl, formatDate, readingTime, type Article } from '../lib/content';

interface Props {
  article: Article;
  /** featured: large lead item. row: compact list row. card: image on top. */
  variant?: 'featured' | 'row' | 'card';
  headingLevel?: 'h2' | 'h3';
}

const { article, variant = 'row', headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, date, category, heroImage, heroImageAlt } = article.data;
---

<article class:list={['article-card', `article-card--${variant}`]}>
  {
    heroImage && variant === 'featured' && (
      <Image
        class="image"
        src={heroImage}
        alt={heroImageAlt ?? ''}
        widths={[480, 800, 1200]}
        sizes="(min-width: 60rem) 60vw, 100vw"
      />
    )
  }
  {
    variant === 'card' &&
      (heroImage ? (
        <Image
          class="image"
          src={heroImage}
          alt={heroImageAlt ?? ''}
          widths={[320, 480, 720]}
          sizes="(min-width: 72rem) 20vw, (min-width: 40rem) 45vw, 100vw"
        />
      ) : (
        <PlaceholderMedia plain tone="sand" ratio="card" detail="Article image to be supplied" />
      ))
  }
  <div class="body">
    <p class="meta">
      <span class="category">{category}</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span>{readingTime(article.body)} min read</span>
    </p>
    <Heading class="title">
      <a href={articleUrl(article)}>{title}</a>
    </Heading>
    <p class="description">{description}</p>
  </div>
  <span class="go" aria-hidden="true">&rarr;</span>
</article>

<style>
  .article-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .article-card--featured {
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
    border: 1px solid var(--color-border);
    border-left: 5px solid var(--color-coral);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .article-card--card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    padding-block: 0;
    border-top: 0;
  }

  .article-card--card .go {
    display: none;
  }

  .article-card--card .image {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
  }

  .article-card--card .title {
    font-size: 1.3125rem;
    line-height: 1.2;
  }

  .article-card--card .description {
    font-size: 0.9688rem;
  }

  .image {
    grid-column: 1 / -1;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin-bottom: 0.5rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .category {
    color: var(--color-teal);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.75rem;
    line-height: 1.75;
  }

  .title {
    font-size: 1.375rem;
  }

  .article-card--featured .title {
    font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.25rem);
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .article-card:hover .title a {
    color: var(--color-teal);
  }

  .description {
    max-width: 40rem;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .article-card--row .description {
    font-size: 1rem;
  }

  .go {
    color: var(--color-coral-strong);
    font-size: 1.375rem;
    transition: transform 0.15s ease;
  }

  .article-card:hover .go {
    transform: translateX(4px);
  }
</style>
