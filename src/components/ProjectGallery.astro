---
/**
 * Responsive image gallery. Images keep their own proportions and open at a larger
 * size when selected. Without JavaScript each image simply links to the larger file.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src: ImageMetadata; alt: string; caption?: string }[];
}

const items = await Promise.all(
  Astro.props.items.map(async (item) => ({
    ...item,
    full: await getImage({ src: item.src, width: Math.min(item.src.width, 1800), format: 'webp' }),
  })),
);
---

<ul class:list={['gallery', { 'gallery--three': items.length > 2 }]} role="list">
  {
    items.map((item) => (
      <li>
        <figure>
          <a
            class="open"
            href={item.full.src}
            data-lightbox
            data-alt={item.alt}
            data-caption={item.caption ?? ''}
          >
            <Image
              src={item.src}
              alt={item.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 48rem) 50vw, 100vw"
            />
            <span class="sr-only">View larger image</span>
          </a>
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" aria-label="Enlarged image">
  <form method="dialog">
    <button class="close" aria-label="Close enlarged image">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </form>
  <img alt="" />
  <p class="lightbox-caption" hidden></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const image = dialog?.querySelector('img');
  const caption = dialog?.querySelector<HTMLElement>('.lightbox-caption');

  if (dialog && image && caption && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        image.src = link.href;
        image.alt = link.dataset.alt ?? '';
        caption.textContent = link.dataset.caption ?? '';
        caption.hidden = !caption.textContent;
        dialog.showModal();
      });
    });

    // A click on the backdrop (outside the image) closes the dialog.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .gallery {
    columns: 1;
    column-gap: 1.5rem;
  }

  @media (min-width: 40rem) {
    .gallery {
      columns: 2;
    }
  }

  @media (min-width: 64rem) {
    .gallery--three {
      columns: 3;
    }
  }

  .gallery li {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  figure {
    margin: 0;
  }

  .open {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    cursor: zoom-in;
  }

  .open :global(img) {
    width: 100%;
    transition: transform 0.25s ease;
  }

  .open:hover :global(img) {
    transform: scale(1.02);
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .lightbox {
    max-width: min(96vw, 1800px);
    max-height: 94vh;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
  }

  .lightbox::backdrop {
    background: rgb(12 30 32 / 0.88);
  }

  .lightbox img {
    max-width: 100%;
    max-height: 86vh;
    margin-inline: auto;
    border-radius: var(--radius-sm);
  }

  .lightbox-caption {
    margin-top: 0.6rem;
    color: #fff;
    font-size: var(--text-sm);
    text-align: center;
  }

  .close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--color-deep);
    cursor: pointer;
  }

  .close:focus-visible {
    outline-color: #fff;
  }
</style>
