---
import { site, nav } from '../site.config';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container inner">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>{site.name}</a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-cta">
          <a class="button button--accent button--small" href="#contact">Contact</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const navEl = document.getElementById('site-nav');

  if (toggle && navEl) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      navEl.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close after following an in-page link such as Contact.
    navEl.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(250 249 246 / 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    min-height: 4.25rem;
  }

  .wordmark {
    color: var(--color-deep);
    font-family: var(--font-heading);
    font-size: 1.4375rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.75rem;
  }

  .nav a:not(.button) {
    position: relative;
    display: inline-block;
    padding-block: 0.6rem;
    color: var(--color-text);
    font-size: 0.9688rem;
    font-weight: 600;
    text-decoration: none;
  }

  .nav a:not(.button)::after {
    content: '';
    position: absolute;
    inset: auto 0 0.3rem 0;
    height: 2px;
    background: var(--color-coral);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.18s ease;
  }

  .nav a:not(.button):hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav a[aria-current='page'] {
    color: var(--color-deep);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-deep);
    cursor: pointer;
  }

  @media (max-width: 47.99rem) {
    /* Without JavaScript the links simply wrap below the wordmark. */
    :global(.js) .nav-toggle {
      display: inline-flex;
    }

    :global(.js) .nav {
      display: none;
      flex-basis: 100%;
      padding-bottom: 1rem;
    }

    :global(.js) .nav.is-open {
      display: block;
    }

    :global(.js) .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    :global(.js) .nav a:not(.button) {
      display: block;
      padding-block: 0.8rem;
      border-top: 1px solid var(--color-border);
      font-size: 1.0625rem;
    }

    :global(.js) .nav a:not(.button)::after {
      display: none;
    }

    :global(.js) .nav-cta {
      padding-top: 0.9rem;
      border-top: 1px solid var(--color-border);
    }
  }
</style>
