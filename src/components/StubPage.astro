---
/** Honest holding page for sections planned in a later milestone. Not indexed. */
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  eyebrow: string;
}

const { title, eyebrow } = Astro.props;
---

<BaseLayout title={title} noindex>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede"><slot /></p>
      <p class="actions">
        <a class="button button--outline" href="/work/">View my work</a>
      </p>
    </header>
  </div>
</BaseLayout>

<style>
  .actions {
    margin-top: 2rem;
  }
</style>
