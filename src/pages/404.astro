---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">404</p>
      <h1>That page isn't here.</h1>
      <p class="lede">
        The link may be out of date, or the page may have moved. These should get you back on
        track.
      </p>
      <p class="actions">
        <a class="button button--accent" href="/">Go to the homepage</a>
        <a class="button button--outline" href="/work/">View my work</a>
      </p>
    </header>
  </div>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
