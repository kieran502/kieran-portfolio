---
/** The single reusable article route. One page is generated per article in src/content/articles. */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles, formatDate, readingTime, type Article } from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);

// Related: same category first, then the most recent others.
const others = (await getArticles()).filter((entry) => entry.id !== article.id);
const related = [
  ...others.filter((entry) => entry.data.category === data.category),
  ...others.filter((entry) => entry.data.category !== data.category),
].slice(0, 3);
---

<BaseLayout
  title={data.title}
  description={data.seoDescription ?? data.description}
  type="article"
  image={data.heroImage?.src}
  publishedTime={data.date}
  modifiedTime={data.updated}
>
  <article class="container">
    <header class="article-header">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/writing/">Writing</a></li>
          <li aria-current="page">{data.category}</li>
        </ol>
      </nav>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <p class="meta">
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        <span>{readingTime(article.body)} min read</span>
        {
          data.updated && (
            <span>
              Updated <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
            </span>
          )
        }
      </p>
    </header>

    {
      data.heroImage && (
        <Image
          class="hero-image"
          src={data.heroImage}
          alt={data.heroImageAlt ?? ''}
          widths={[640, 960, 1440]}
          sizes="(min-width: 72rem) 68rem, 100vw"
          loading="eager"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      data.tags.length > 0 && (
        <footer class="article-footer">
          <h2 class="sr-only">Tags</h2>
          <ul class="pills">
            {data.tags.map((tag) => (
              <li class="pill">{tag}</li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section class="container related" aria-labelledby="related-heading">
        <div class="section-head">
          <h2 id="related-heading">Related articles</h2>
          <a class="text-link" href="/writing/">
            All writing <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="related-list">
          {related.map((entry) => (
            <ArticleCard article={entry} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .article-header {
    max-width: 50rem;
    padding-block: 1.5rem clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }

  .article-header h1 {
    margin-top: clamp(1.75rem, 1rem + 3vw, 3.25rem);
    font-size: clamp(2.125rem, 1.5rem + 3vw, 3.375rem);
  }

  .article-header .lede {
    max-width: 44rem;
    margin-top: 1.25rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .hero-image {
    width: 100%;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    object-fit: cover;
  }

  .article-footer {
    max-width: var(--measure);
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .related {
    padding-top: var(--space-section);
  }

  .related-list {
    border-bottom: 1px solid var(--color-border);
  }
</style>
