---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderMedia from '../components/PlaceholderMedia.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StatItem from '../components/StatItem.astro';
import OrganisationLogos from '../components/OrganisationLogos.astro';
import { capabilities, approach, plannedResources } from '../site.config';
import { getProjects, getArticles, projectUrl } from '../lib/content';

// The hero shows src/assets/headshot.(jpg|jpeg|png|webp) when that file exists,
// and a marked placeholder when it does not.
const headshot = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/headshot.{jpg,jpeg,png,webp}', {
    eager: true,
  }),
)[0]?.default;

const projects = await getProjects();
const featuredProjects = projects.filter((project) => project.data.featured);
// The first two featured projects lead; the next two follow in a supporting row.
const leadProjects = featuredProjects.slice(0, 2);
const supportingProjects = featuredProjects.slice(2, 4);

// Published articles only: drafts and samples never appear on the homepage, even in development.
const recentArticles = (await getArticles()).filter((article) => !article.data.draft).slice(0, 3);
const writingTopics = ['Technology leadership', 'Product delivery', 'Practical AI adoption'];

// Outcome figures are pulled from featured projects, so they always carry their context.
// Only verified figures appear: the strip sizes itself to however many there are.
const projectStats = featuredProjects.flatMap((project) =>
  project.data.stats.map((stat) => ({
    value: stat.value,
    label: stat.label,
    context: stat.context,
    href: project.data.caseStudyReady ? projectUrl(project) : undefined,
    linkLabel: `Read the ${project.data.title} case study`,
  })),
);

const [featuredResource] = plannedResources;
const formatLabels = { interactive: 'Interactive tool', pdf: 'PDF download' };

const icons: Record<string, string> = {
  product: 'M4 7l8-4 8 4-8 4-8-4zm0 5l8 4 8-4M4 17l8 4 8-4',
  ai: 'M8 8h8v8H8V8zM10 4v4M14 4v4M10 16v4M14 16v4M4 10h4M4 14h4M16 10h4M16 14h4',
  technical: 'M8 7l-5 5 5 5M16 7l5 5-5 5M13.5 4l-3 16',
  team: 'M9 11a3.5 3.5 0 100-7 3.5 3.5 0 000 7zm-6.5 9a6.5 6.5 0 0113 0M16 4.2a3.5 3.5 0 010 6.6M18 14.2a6.5 6.5 0 013.5 5.8',
};

// One icon per "How I work" step, in order.
const stepIcons = [
  'M12 21a9 9 0 100-18 9 9 0 000 18zm0-4a5 5 0 100-10 5 5 0 000 10zm0-4a1 1 0 100-2 1 1 0 000 2z',
  'M4 7l8-4 8 4-8 4-8-4zm0 5l8 4 8-4M4 17l8 4 8-4',
  'M4 5h16v11H9l-5 4V5zm4 4h8M8 12h5',
  'M5 20v-6M10 20V10M15 20v-8M20 20V5',
];
---

<BaseLayout wide sansHeadings>
  <!-- Hero: copy, portrait, capabilities -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Technology <span aria-hidden="true">/</span> Product <span aria-hidden="true">/</span> AI</p>
        <h1>Technology and product leadership that delivers real results.</h1>
        <hr class="rule" />
        <p class="lede">
          For more than 15 years I've led digital products from first idea through launch and
          ongoing improvement: setting product and technical direction, leading multidisciplinary
          teams, and finding practical uses for AI and automation.
        </p>
        <div class="hero-actions">
          <a class="button button--accent button--large" href="/work/">
            View my work <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="button button--outline button--large" href="#contact">Get in touch</a>
        </div>
      </div>

      <div class="hero-visual">
        {
          headshot ? (
            <Image
              class="headshot"
              src={headshot}
              alt="Kieran Sawyer"
              widths={[360, 500, 720, 1000]}
              sizes="(min-width: 76rem) 25rem, (min-width: 48rem) 42vw, 86vw"
              loading="eager"
            />
          ) : (
            <PlaceholderMedia
              title="KS"
              label="Headshot placeholder: approved photo to be supplied"
              tone="deep"
              ratio="portrait"
            />
          )
        }
      </div>

      <div class="hero-capabilities">
        <h2 class="sr-only">What I bring</h2>
        <ul class="capabilities" role="list">
          {
            capabilities.map((item) => (
              <li>
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d={icons[item.icon]}
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Organisations: shown only for logos whose approved artwork is in src/assets/logos/ -->
  <OrganisationLogos />

  <!-- Featured work: two lead projects, two supporting -->
  <section class="featured" aria-labelledby="featured-heading">
    <div class="container">
      <div class="section-top">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 id="featured-heading">Featured projects</h2>
        </div>
        <a class="text-link" href="/work/">
          View all work <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <ul class="project-grid" role="list">
        {
          leadProjects.map((project) => (
            <li>
              <ProjectCard project={project} variant="panel" />
            </li>
          ))
        }
        {
          supportingProjects.map((project) => (
            <li>
              <ProjectCard project={project} variant="row" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Impact strip -->
  <section class="impact" aria-labelledby="impact-heading">
    <div class="container impact-inner">
      <h2 id="impact-heading">The impact in numbers.</h2>
      <div class="impact-stats">
        <StatItem
          inverse
          value="15+ years"
          label="of digital product and technology delivery experience"
          context="Leading products and multidisciplinary teams for organisations in healthcare, education, aviation, consumer products and enterprise."
        />
        {projectStats.map((stat) => <StatItem inverse {...stat} />)}
      </div>
    </div>
  </section>

  <!-- How I work -->
  <section class="approach-band" aria-labelledby="approach-heading">
    <div class="container approach-inner">
      <div class="approach-intro">
        <p class="eyebrow">My approach</p>
        <h2 id="approach-heading">How I work.</h2>
      </div>
      <ol class="approach" role="list">
        {
          approach.map((step, index) => (
            <li>
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d={stepIcons[index % stepIcons.length]}
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Writing and resources -->
  <section class="library-band">
    <div class:list={['container', 'library', { 'library--intro-only': recentArticles.length === 0 }]}>
      {
        recentArticles.length > 0 ? (
          <>
            <div class="library-intro">
              <p class="eyebrow">Recent writing</p>
              <h2>Ideas, lessons and practical notes.</h2>
              <p class="library-lede">
                I write about technology leadership, product delivery and practical AI adoption.
              </p>
              <a class="text-link" href="/writing/">
                All writing <span class="arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
            <ul class="article-grid" role="list">
              {recentArticles.map((article) => (
                <li>
                  <ArticleCard article={article} variant="card" />
                </li>
              ))}
            </ul>
          </>
        ) : (
          <div class="library-intro library-editorial">
            <p class="eyebrow">Writing</p>
            <h2>Ideas, lessons and practical notes.</h2>
            <p class="library-lede">
              I write about technology leadership, product delivery and practical AI adoption,
              drawing on what has and hasn't worked on real projects.
            </p>
            <ul class="topics" role="list">
              {writingTopics.map((topic) => (
                <li>{topic}</li>
              ))}
            </ul>
            <a class="text-link" href="/writing/">
              Go to writing <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        )
      }

      {
        featuredResource && (
          <aside class="resource" aria-labelledby="resource-heading">
            <p class="resource-eyebrow">
              <span>Featured resource</span>
              <span class="status-pill">In development</span>
            </p>
            <h2 id="resource-heading">{featuredResource.title}</h2>
            <p class="resource-format">{formatLabels[featuredResource.format]}</p>
            <p class="resource-summary">{featuredResource.summary}</p>
            <p class="resource-status">It will be published here when it is ready.</p>
          </aside>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Shared ---------- */
  h2 {
    font-size: clamp(1.875rem, 1.45rem + 1.9vw, 2.875rem);
    line-height: 1.05;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
    color: var(--color-deep);
    letter-spacing: 0.12em;
  }

  .section-top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: clamp(1.25rem, 1rem + 1.2vw, 2rem);
  }

  .text-link {
    font-size: 1.0625rem;
  }

  .button--large {
    min-height: 3.25rem;
    padding-inline: 1.6rem;
    font-size: 1.0625rem;
  }

  .button--deep {
    background: var(--color-deep);
    color: #fff;
  }

  .button--deep:hover {
    background: var(--color-teal);
    color: #fff;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-areas: 'copy' 'visual' 'caps';
    align-items: center;
    gap: 2.5rem clamp(2rem, 0.5rem + 3.4vw, 3.5rem);
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem);
  }

  .hero-copy {
    grid-area: copy;
  }

  .hero-visual {
    grid-area: visual;
  }

  .hero-capabilities {
    grid-area: caps;
  }

  h1 {
    font-size: clamp(2.375rem, 1.5rem + 3.6vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .hero .rule {
    width: 5rem;
    height: 6px;
    margin-block: clamp(1.25rem, 1rem + 1vw, 1.875rem);
    border-radius: 3px;
  }

  .hero .lede {
    max-width: 34rem;
    font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem);
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
  }

  /* Portrait in front of the single coral disc. */
  .hero-visual {
    position: relative;
    width: min(84%, 24rem);
  }

  .hero-visual::before {
    content: '';
    position: absolute;
    right: -17%;
    bottom: -7%;
    width: 88%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-coral);
  }

  .hero-visual :global(.ph),
  .headshot {
    position: relative;
    border-radius: calc(var(--radius) + 6px);
    box-shadow: 0 24px 48px rgb(24 60 64 / 0.18);
  }

  .headshot {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .hero-visual :global(.ph-title) {
    font-size: clamp(3rem, 22cqi, 7rem);
  }

  .capabilities {
    display: grid;
    gap: 1.5rem 2.5rem;
  }

  .capabilities li {
    display: flex;
    gap: 1rem;
  }

  .capabilities svg {
    flex: none;
    color: var(--color-coral-strong);
  }

  .capabilities h3 {
    font-size: 1.125rem;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .capabilities p {
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: 0.9688rem;
    line-height: 1.4;
  }

  @media (min-width: 36rem) {
    .capabilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .hero-inner {
      grid-template-areas: 'copy visual' 'caps caps';
      grid-template-columns: minmax(0, 1fr) minmax(0, min(42%, 25rem));
    }

    .hero-visual {
      width: 100%;
    }

    .hero-capabilities {
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }
  }

  @media (min-width: 48rem) and (max-width: 75.99rem) {
    h1 {
      font-size: clamp(2.25rem, 5vw, 3.25rem);
    }
  }

  @media (min-width: 62rem) and (max-width: 75.99rem) {
    .capabilities {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .capabilities li {
      flex-direction: column;
      gap: 0.6rem;
    }
  }

  @media (min-width: 76rem) {
    .hero-inner {
      grid-template-areas: 'copy visual caps';
      grid-template-columns: minmax(0, 1fr) 25rem 16.5rem;
    }

    .hero-capabilities {
      padding-top: 0;
      padding-left: 0.5rem;
      border-top: 0;
    }

    .capabilities {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }

  /* ---------- Featured work ---------- */
  .featured {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .project-grid {
    display: grid;
    gap: clamp(1rem, 0.75rem + 1vw, 1.5rem);
  }

  @media (min-width: 72rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Impact strip ---------- */
  .impact {
    background: var(--color-deep);
    color: #dbe7e6;
  }

  .impact-inner {
    display: grid;
    align-items: center;
    gap: 2rem clamp(2rem, 1rem + 4vw, 5rem);
    padding-block: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .impact h2 {
    max-width: 14rem;
    color: #fff;
    font-size: clamp(2rem, 1.6rem + 1.8vw, 2.875rem);
  }

  .impact-stats {
    display: grid;
    gap: 2rem clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  @media (min-width: 40rem) {
    .impact-stats {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .impact-inner {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }

  .impact :global(.stat .value) {
    font-weight: 800;
  }

  .impact :global(.stat) {
    border-left: 1px solid rgb(255 255 255 / 0.35);
  }

  /* ---------- How I work ---------- */
  .approach-band {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .approach-inner {
    display: grid;
    gap: 2rem clamp(2rem, 1rem + 3vw, 4rem);
    padding-block: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .approach {
    display: grid;
    gap: 1.75rem 0;
  }

  .approach li {
    padding-inline: 0;
  }

  .approach svg {
    margin-bottom: 0.75rem;
    color: var(--color-coral-strong);
  }

  .approach h3 {
    font-size: 1.1875rem;
    letter-spacing: -0.015em;
  }

  .approach p {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.9688rem;
    line-height: 1.45;
  }

  @media (min-width: 36rem) {
    .approach {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }

  @media (min-width: 62rem) {
    .approach {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 0;
    }

    .approach li {
      padding-inline: clamp(1rem, 0.5rem + 1vw, 1.75rem);
      border-left: 1px solid var(--color-border);
    }
  }

  @media (min-width: 76rem) {
    .approach-inner {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: center;
    }
  }

  /* ---------- Writing and resources ---------- */
  /* The footer supplies the space below this band. */
  .library-band {
    padding-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .library {
    display: grid;
    align-items: start;
    gap: 2.5rem clamp(2rem, 1rem + 2.5vw, 3rem);
  }

  .library-intro h2 {
    margin-bottom: 1.25rem;
    font-size: clamp(1.875rem, 1.5rem + 1.4vw, 2.5rem);
  }

  .article-grid {
    display: grid;
    gap: 2rem clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  @media (min-width: 36rem) {
    .article-grid {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }
  }

  .resource {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
    border-radius: calc(var(--radius) + 4px);
    background: var(--color-coral-soft);
  }

  .resource-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    color: #a53d29;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .status-pill {
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.75);
    letter-spacing: 0.08em;
  }

  .resource-summary {
    color: var(--color-deep);
    font-size: var(--text-lg);
    line-height: 1.4;
  }

  .resource-status {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(24 60 64 / 0.15);
    align-self: stretch;
    color: #4c5f6e;
    font-size: 0.9375rem;
  }

  .library-lede {
    max-width: 34rem;
    margin-bottom: 1.25rem;
    font-size: var(--text-lg);
    line-height: 1.45;
  }

  .library-intro h2 + .library-lede {
    margin-top: -0.25rem;
  }

  .topics {
    display: grid;
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }

  .topics li {
    position: relative;
    padding: 0.8rem 0 0.8rem 1.75rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-deep);
    font-weight: 600;
  }

  .topics li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .topics li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.45rem;
    width: 0.9rem;
    height: 3px;
    border-radius: 2px;
    background: var(--color-coral);
  }

  .resource h2 {
    font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
  }

  .resource-format {
    color: var(--color-deep);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 62rem) {
    .library {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }

    .library-intro {
      grid-column: 1 / -1;
    }

    /* No published articles yet: the editorial introduction and the resource share the row. */
    .library--intro-only {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
    }

    .library--intro-only .library-intro {
      grid-column: auto;
    }
  }

  @media (min-width: 76rem) {
    .library:not(.library--intro-only) {
      grid-template-columns: 14.5rem minmax(0, 1fr) 23rem;
    }

    .library-intro {
      grid-column: auto;
    }
  }
</style>
