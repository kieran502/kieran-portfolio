---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { SECTORS, CAPABILITIES } from '../../content.config';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const featured = projects.filter((project) => project.data.featured);
const others = projects.filter((project) => !project.data.featured);

// Only offer filters that match at least one project.
const sectors = SECTORS.filter((sector) => projects.some((p) => p.data.sector === sector));
const capabilities = CAPABILITIES.filter((capability) =>
  projects.some((p) => p.data.capabilities.includes(capability)),
);

const groups = [
  { key: 'sector', label: 'Sectors', options: sectors },
  { key: 'capability', label: 'Capabilities', options: capabilities },
];
---

<BaseLayout
  title="Selected work"
  description="Selected digital products, platforms and technology projects from Kieran Sawyer's delivery record, filterable by sector and capability."
  wide
  sansHeadings
>
  <div class="container">
    <header class="intro">
      <div>
        <p class="eyebrow">Work</p>
        <h1>Selected work</h1>
      </div>
      <div class="intro-copy">
        <p class="lede">
          A selection of digital products, platforms and technology projects I've helped shape and
          deliver across healthcare, education, consumer products and enterprise.
        </p>
        <p class="support">
          These projects span product ownership, technical leadership, digital transformation,
          immersive technology and operational improvement.
        </p>
      </div>
    </header>

    <div class="filters" data-filter-root>
      {
        groups.map((group) => (
          <fieldset>
            <legend>{group.label}</legend>
            <div class="filter-options">
              <button type="button" class="filter" data-filter-group={group.key} data-value="all" aria-pressed="true">
                All
              </button>
              {group.options.map((option) => (
                <button type="button" class="filter" data-filter-group={group.key} data-value={option} aria-pressed="false">
                  {option}
                </button>
              ))}
            </div>
          </fieldset>
        ))
      }
      <p class="filter-status" role="status" data-filter-status>
        Showing all {projects.length} projects
      </p>
    </div>

    <section class="project-section" aria-labelledby="featured-heading" data-project-section>
      <div class="group-head">
        <p class="eyebrow">Featured</p>
        <h2 id="featured-heading">Featured projects</h2>
      </div>
      <ul class="grid grid--featured" role="list">
        {
          featured.map((project) => (
            <li>
              <ProjectCard project={project} variant="featured" headingLevel="h3" />
            </li>
          ))
        }
      </ul>
    </section>

    {
      others.length > 0 && (
        <section class="project-section project-section--more" aria-labelledby="more-heading" data-project-section>
          <div class="group-head">
            <p class="eyebrow">Wider portfolio</p>
            <h2 id="more-heading">More projects</h2>
          </div>
          <ul class="grid grid--compact" role="list">
            {others.map((project) => (
              <li>
                <ProjectCard project={project} variant="compact" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="empty" data-filter-empty hidden>
      No projects match both filters.
      <button type="button" class="reset" data-filter-reset>Clear filters</button>
    </p>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-filter-root]');

  if (root) {
    const state: Record<string, string> = { sector: 'all', capability: 'all' };
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter-group]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'));
    const sections = document.querySelectorAll<HTMLElement>('[data-project-section]');
    const status = root.querySelector<HTMLElement>('[data-filter-status]');
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    const reset = document.querySelector<HTMLButtonElement>('[data-filter-reset]');

    const apply = () => {
      let shown = 0;

      for (const card of cards) {
        const matchesSector = state.sector === 'all' || card.dataset.sector === state.sector;
        const matchesCapability =
          state.capability === 'all' ||
          (card.dataset.capabilities ?? '').split('|').includes(state.capability);
        const visible = matchesSector && matchesCapability;
        (card.closest('li') ?? card).hidden = !visible;
        if (visible) shown += 1;
      }

      for (const section of sections) {
        // A group (featured or wider portfolio) disappears when none of its projects match.
        section.hidden = !Array.from(section.querySelectorAll<HTMLElement>('[data-project]')).some(
          (card) => !(card.closest('li') ?? card).hidden,
        );
      }

      for (const button of buttons) {
        const group = button.dataset.filterGroup ?? '';
        button.setAttribute('aria-pressed', String(state[group] === button.dataset.value));
      }

      if (status) {
        status.textContent =
          shown === cards.length
            ? `Showing all ${cards.length} projects`
            : `Showing ${shown} of ${cards.length} projects`;
      }
      if (empty) empty.hidden = shown > 0;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        state[button.dataset.filterGroup ?? ''] = button.dataset.value ?? 'all';
        apply();
      });
    }

    reset?.addEventListener('click', () => {
      state.sector = 'all';
      state.capability = 'all';
      apply();
      buttons[0]?.focus();
    });
  }
</script>

<style>
  /* ---- Introduction ---- */
  .intro {
    display: grid;
    align-items: end;
    gap: 1.5rem clamp(2rem, 1rem + 4vw, 4.5rem);
    padding-block: clamp(2.25rem, 1.5rem + 3.5vw, 4.5rem) clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }

  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .intro h1 {
    font-size: clamp(3rem, 2rem + 5vw, 5.75rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .intro .lede {
    max-width: 40rem;
    color: var(--color-deep);
    font-size: clamp(1.1875rem, 1.1rem + 0.5vw, 1.4375rem);
    font-weight: 550;
    line-height: 1.4;
  }

  .support {
    max-width: 40rem;
    margin-top: 0.9rem;
    color: var(--color-muted);
  }

  /* ---- Filters. They need JavaScript; without it the full list is simply shown. ---- */
  .filters {
    display: none;
    padding: clamp(1rem, 0.75rem + 1vw, 1.5rem) clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  :global(.js) .filters {
    display: grid;
    gap: 0.85rem;
  }

  fieldset {
    display: grid;
    gap: 0.5rem 1.25rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  @media (min-width: 48rem) {
    fieldset {
      grid-template-columns: 8rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  legend {
    float: left; /* lets the legend take part in the grid */
    padding: 0;
    color: var(--color-deep);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* Small screens: each group is one swipeable row, so the controls stay compact. */
  @media (max-width: 47.99rem) {
    .filter-options {
      flex-wrap: nowrap;
      margin-inline: calc(clamp(1rem, 0.5rem + 1.5vw, 1.75rem) * -1);
      padding: 0.2rem clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .filter-options::-webkit-scrollbar {
      display: none;
    }

    .filter {
      flex: none;
    }
  }

  .filter {
    min-height: 2.5rem;
    padding: 0.3rem 0.95rem;
    border: 1.5px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .filter:hover {
    border-color: var(--color-teal);
  }

  .filter[aria-pressed='true'] {
    border-color: var(--color-deep);
    background: var(--color-deep);
    color: #fff;
  }

  .filter-status {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* ---- Project groups ---- */
  .project-section {
    padding-top: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .project-section--more {
    margin-top: clamp(2.5rem, 2rem + 2.5vw, 4rem);
    border-top: 1px solid var(--color-border);
  }

  .group-head {
    margin-bottom: clamp(1.25rem, 1rem + 1.2vw, 2rem);
  }

  .group-head h2 {
    font-size: clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem);
    line-height: 1.05;
  }

  .grid {
    display: grid;
    gap: clamp(1.5rem, 1.2rem + 1.4vw, 2rem);
  }

  .grid--compact {
    gap: clamp(2rem, 1.5rem + 2vw, 3rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .grid--compact {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .empty {
    padding-block: 3rem;
    font-size: var(--text-lg);
  }

  .reset {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-coral-strong);
    font: inherit;
    font-weight: 650;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
