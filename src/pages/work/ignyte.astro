---
/**
 * Ignyte case study. Ignyte has its own page (rather than the shared [id].astro template)
 * because its story is led by product decisions. Structured data (key highlights, skills,
 * technologies, classification) lives in src/content/projects/ignyte/index.md;
 * the narrative copy lives here.
 *
 * Accuracy rules: no learner numbers, savings, completion rates or the £250,000 estimate.
 * Better preparation and stronger practical sales skills are client feedback and are
 * labelled as such. Learners used simpler AI-assisted practice; advanced versions were pilots.
 */
import { Image } from 'astro:assets';
import { getEntry, getEntries } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectClassification from '../../components/ProjectClassification.astro';
import dashboardImage from '../../content/projects/ignyte/ignyte-1.jpg';

const project = await getEntry('projects', 'ignyte');
if (!project) throw new Error('The ignyte project entry is missing.');
const { data } = project;

const keyFacts = data.classification?.keyFacts ?? [];
const technologies = data.classification?.technologies ?? [];
const platformTech = technologies.filter((t) => t.usage === 'core' && !t.note);
const gameTech = technologies.filter((t) => t.usage === 'core' && t.note);
const aiTech = technologies.filter((t) => t.usage !== 'core');

// Every related card must link through, so only projects with a case study are shown.
const related = (await getEntries(data.relatedProjects)).filter(
  (entry) => entry.data.caseStudyReady && (import.meta.env.DEV || !entry.data.draft),
);

const chapters = [
  { id: 'problem', title: 'The problem' },
  { id: 'decisions', title: 'The product decisions' },
  { id: 'product', title: 'Developing the product' },
  { id: 'training', title: 'Changing the training' },
  { id: 'team', title: 'Leading the team' },
  { id: 'technology', title: 'The technology' },
  { id: 'origins', title: 'How it came about' },
  { id: 'ownership', title: 'Running it at scale' },
  { id: 'reflection', title: 'What I took from it' },
  { id: 'skills', title: 'Skills demonstrated' },
];

const journey = [
  {
    title: 'The idea',
    text: 'The idea came from conversations about how pharmaceutical companies could continue training their medical science liaisons and key account managers. I came up with the product and pitched the approach to a client.',
  },
  {
    title: 'A SharePoint first version',
    text: 'They liked the concept, but a dedicated platform would take too long for their immediate needs. Rather than abandon the idea, I developed a quicker SharePoint-based solution to organise and distribute their training material.',
  },
  {
    title: 'Learning what the product needed',
    text: 'That first version demonstrated the approach and clarified what a purpose-built product would need to do.',
  },
  {
    title: 'Funded development',
    text: 'A second client then funded the initial development of Ignyte, built from the start as one configurable product rather than a system for a single organisation.',
  },
];

const considerations = [
  'Development effort',
  'Commercial value',
  'Technical complexity',
  'Ongoing support',
];

const compliance = [
  'Security assessments',
  'Penetration testing',
  'Data protection and GDPR',
  'Client-specific approval processes, including German Works Council involvement',
];

const scaleEffects = [
  {
    term: 'Configuration',
    text: 'Each client organisation had its own branding, content and programme structure. Differences had to be handled through configuration of the shared platform, not separate code for each client.',
  },
  {
    term: 'Permissions',
    text: 'Organisations had different access requirements, and learners, facilitators and administrators each needed access to the right programmes and data.',
  },
  {
    term: 'Support',
    text: 'Onboarding and ongoing support had to work for organisations across many countries, each with its own security reviews and approval processes.',
  },
];
---

<BaseLayout
  title={`${data.title} case study`}
  description={data.seoDescription ?? data.summary}
  type="article"
  wide
  sansHeadings
>
  <article class="ignyte">
    <!-- ================= Hero ================= -->
    <header class="hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/work/">Selected work</a></li>
            <li aria-current="page">{data.title}</li>
          </ol>
        </nav>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="tags">
              <span>Product ownership</span>
              <span>Technical leadership</span>
              <span>Healthcare learning</span>
            </p>
            <h1>{data.title}</h1>
            <p class="headline">{data.headline}</p>
            <hr class="rule" />
            <p class="hero-intro">
              I came up with the idea for Ignyte, led its development at Prescript Communications
              and continue to maintain it today.
            </p>
          </div>
          <div class="hero-media">
            <ProjectMedia
              project={project}
              ratio="wide"
              sizes="(min-width: 60rem) 56vw, 100vw"
              eager
            />
          </div>
        </div>
      </div>
    </header>

    <!-- ================= Key highlights ================= -->
    {
      keyFacts.length > 0 && (
        <section class="facts" aria-labelledby="facts-heading">
          <div class="container">
            <h2 id="facts-heading" class="sr-only">
              Key highlights
            </h2>
            <ul class="facts-grid" role="list">
              {keyFacts.map((fact) => (
                <li class:list={['fact', `fact--${fact.kind}`]}>
                  <p class="fact-figure">
                    <span class="fact-value">{fact.value}</span>
                    {fact.unit && <span class="fact-unit"> {fact.unit}</span>}
                  </p>
                  <p class="fact-label">{fact.label}</p>
                  {fact.context && <p class="fact-context">{fact.context}</p>}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- ================= Story ================= -->
    <div class="container story">
      <nav class="toc" aria-labelledby="toc-heading">
        <p id="toc-heading" class="toc-title">On this page</p>
        <ol role="list">
          {
            chapters.map((chapter) => (
              <li>
                <a href={`#${chapter.id}`} data-toc-link>
                  {chapter.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="chapters">
        <section id="problem" class="chapter" aria-labelledby="problem-heading" data-chapter>
          <p class="eyebrow">The problem</p>
          <h2 id="problem-heading">When classroom training stopped</h2>
          <div class="copy">
            <p class="lead">
              When COVID stopped classroom training, pharmaceutical organisations needed a different
              way to prepare their medical and commercial teams.
            </p>
            <p>
              Sending large PowerPoint presentations and PDFs by email wasn't a particularly
              effective answer. Learners needed structure, opportunities to practise and a way to
              demonstrate that they understood the material. I saw an opportunity to build something
              better.
            </p>
          </div>
        </section>

        <section id="decisions" class="chapter" aria-labelledby="decisions-heading" data-chapter>
          <p class="eyebrow">The product decisions</p>
          <h2 id="decisions-heading">One configurable product, not a one-off build</h2>
          <div class="copy">
            <p>
              The first client couldn't wait for a dedicated platform, so I gave them a quicker
              SharePoint-based version. When a second client funded development, I made the decision
              that shaped everything after it: build one configurable product that could be licensed
              across clients, rather than a system that only worked for one organisation.
            </p>
            <p>
              That meant deciding what should be built. Some clients wanted functionality that could
              benefit every organisation using Ignyte; others had highly specific requests. Every
              request had to be weighed against:
            </p>
          </div>
          <ul class="considerations" role="list">
            {considerations.map((item) => <li>{item}</li>)}
          </ul>
          <div class="copy">
            <p>
              Where possible, I favoured functionality that could become part of the shared product.
              That let us maintain one underlying platform while providing different branding,
              content and configurations for individual organisations.
            </p>
          </div>
          <blockquote class="pull">
            <p>
              A feature that appears straightforward to build can become expensive if it needs years
              of maintenance.
            </p>
          </blockquote>
        </section>

        <section id="product" class="chapter" aria-labelledby="product-heading" data-chapter>
          <p class="eyebrow">Developing the product</p>
          <h2 id="product-heading">From training library to learning platform</h2>
          <div class="copy">
            <p>
              The initial platform focused on organising training materials, delivering assessments
              and recording progress. Over time, it became significantly more capable.
            </p>
            <p>
              We introduced configurable learning pages, quizzes, video content, interactive
              exercises, gamification, competency tracking and facilitator dashboards. Clients could
              structure different training programmes, monitor individual progress and identify
              areas where additional support was needed. Automated reminders and recertification
              tracking helped organisations manage ongoing training requirements.
            </p>
          </div>

          <figure class="figure">
            <Image
              src={dashboardImage}
              alt="Ignyte's Engagement Metrics page for an oncology course. A table lists average in-progress and completion confidence for each module, beside a ranked table of learner activity and a heat map of learner engagement hours across the week."
              widths={[640, 960, 1400]}
              sizes="(min-width: 64rem) 48rem, 100vw"
            />
            <figcaption>
              A real Ignyte facilitator dashboard, with names and identifying details changed:
              confidence by module, learner activity and the times of day people were learning.
            </figcaption>
          </figure>

          <div class="copy">
            <p>
              We also developed more intelligent ways of using assessment information. For example,
              learners could receive recommendations about subjects they needed to revisit, based on
              their previous answers.
            </p>
            <p>
              The platform included focus features designed to reduce distractions during
              assessments, along with indicators of potentially unusual assessment behaviour. These
              gave facilitators information to review, rather than automatically accusing anyone of
              cheating.
            </p>
          </div>

          <aside class="note-panel" aria-labelledby="ai-heading">
            <p id="ai-heading" class="note-label">AI-assisted sales practice</p>
            <dl class="ai-split">
              <div>
                <dt>Used by learners</dt>
                <dd>Simpler AI-assisted scenarios for practising sales conversations, built with OpenAI technology and Amazon Polly.</dd>
              </div>
              <div>
                <dt>Piloted only</dt>
                <dd>More advanced versions, which remained pilots and were not fully deployed.</dd>
              </div>
            </dl>
          </aside>
        </section>

        <section id="training" class="chapter" aria-labelledby="training-heading" data-chapter>
          <p class="eyebrow">Improving the training experience</p>
          <h2 id="training-heading">Moving the basics out of the training room</h2>
          <div class="copy">
            <p>
              One of Ignyte's most useful effects was on the final face-to-face training, which
              involved specialist trainers and significant time commitments.
            </p>
          </div>

          <div class="compare">
            <div class="compare-col">
              <h3>Before</h3>
              <p>
                Learners could arrive with substantial gaps in their knowledge and practical
                preparation. Trainers had to spend valuable time covering fundamentals before moving
                on to more advanced exercises.
              </p>
            </div>
            <div class="compare-col compare-col--after">
              <h3>With Ignyte</h3>
              <p>
                Learners completed much of their theoretical learning, formal assessments and
                practical preparation beforehand, so the final one or two days could concentrate on
                refining skills.
              </p>
            </div>
          </div>

          <aside class="feedback" aria-labelledby="feedback-heading">
            <p id="feedback-heading" class="note-label">Client feedback</p>
            <p>
              Clients reported that learners were arriving better prepared for those sessions, with
              stronger practical sales skills.
            </p>
          </aside>

          <div class="copy">
            <p>
              The platform also gave facilitators better visibility of progress, and gave
              organisations records of completed assessments, training and recertification.
            </p>
          </div>
        </section>

        <section id="team" class="chapter" aria-labelledby="team-heading" data-chapter>
          <p class="eyebrow">Leading the team and delivery</p>
          <h2 id="team-heading">From one developer to a multidisciplinary team</h2>

          <ol class="growth" role="list" aria-label="How the team grew">
            <li style="--share: 5%">
              <span class="growth-bar" aria-hidden="true"></span>
              <span class="growth-value">1</span>
              <span class="growth-label">Developer when I started</span>
            </li>
            <li style="--share: 50%">
              <span class="growth-bar" aria-hidden="true"></span>
              <span class="growth-value">Up to 10</span>
              <span class="growth-label">Core development team I went on to lead</span>
            </li>
            <li style="--share: 100%">
              <span class="growth-bar" aria-hidden="true"></span>
              <span class="growth-value">Up to 20</span>
              <span class="growth-label">
                Wider team, including designers, medical writers and other specialists
              </span>
            </li>
          </ol>

          <div class="copy">
            <p>
              I started with one developer and went on to lead a core development team of up to ten.
              My responsibilities included product strategy, the roadmap, technical direction, client
              demonstrations, commercial discussions, onboarding and ongoing support.
            </p>
            <p>
              I worked directly with senior client stakeholders to understand requirements, manage
              expectations and agree priorities. I also oversaw the technical and compliance
              considerations involved in delivering software to pharmaceutical organisations, some of
              which had particularly demanding requirements.
            </p>
          </div>
          <ul class="compliance" role="list" aria-label="Compliance work">
            {compliance.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section id="technology" class="chapter" aria-labelledby="technology-heading" data-chapter>
          <p class="eyebrow">The technology</p>
          <h2 id="technology-heading">Built to be owned for years</h2>
          <div class="copy">
            <p>
              The architecture needed to accommodate multiple organisations, configurable content,
              branding and different access requirements. I made these technical decisions with
              long-term ownership, security and maintainability in mind.
            </p>
          </div>
          <dl class="stack">
            {
              platformTech.length > 0 && (
                <div>
                  <dt>Core platform</dt>
                  <dd>
                    <ul class="pills" role="list">
                      {platformTech.map((t) => (
                        <li class="pill">{t.name}</li>
                      ))}
                    </ul>
                    <p>PHP and Laravel with a MariaDB database, hosted on AWS and deployed with Laravel Forge.</p>
                  </dd>
                </div>
              )
            }
            {
              gameTech.length > 0 && (
                <div>
                  <dt>Interactive games</dt>
                  <dd>
                    <ul class="pills" role="list">
                      {gameTech.map((t) => (
                        <li class="pill">{t.name}</li>
                      ))}
                    </ul>
                    <p>Developed in Unity and embedded within the platform.</p>
                  </dd>
                </div>
              )
            }
            {
              aiTech.length > 0 && (
                <div>
                  <dt>AI-assisted practice</dt>
                  <dd>
                    <ul class="pills" role="list">
                      {aiTech.map((t) => (
                        <li class="pill pill--pilot">{t.name}</li>
                      ))}
                    </ul>
                    <p>
                      Simpler practice scenarios used by learners; more advanced versions piloted
                      only. Not part of the core platform.
                    </p>
                  </dd>
                </div>
              )
            }
          </dl>
        </section>

        <section id="origins" class="chapter" aria-labelledby="origins-heading" data-chapter>
          <p class="eyebrow">How it came about</p>
          <h2 id="origins-heading">From a pitch to a product</h2>
          <ol class="journey" role="list">
            {
              journey.map((step, index) => (
                <li>
                  <span class="journey-marker" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <section id="ownership" class="chapter" aria-labelledby="ownership-heading" data-chapter>
          <p class="eyebrow">Scale and long-term ownership</p>
          <h2 id="ownership-heading">What running it at scale meant</h2>
          <div class="copy">
            <p>
              With more than ten organisations on one platform, some of them operating in 20+
              countries, growth was as much an operational question as a development one.
            </p>
          </div>
          <dl class="effects">
            {
              scaleEffects.map((item) => (
                <div>
                  <dt>{item.term}</dt>
                  <dd>{item.text}</dd>
                </div>
              ))
            }
          </dl>
          <blockquote class="pull">
            <p>
              Launching software is one part of the job. The decisions made during development affect
              how easily it can be supported, improved and adapted years later.
            </p>
          </blockquote>
          <div class="copy">
            <p>
              I led Ignyte for four years at Prescript Communications and still maintain it today,
              so I see the consequences of those early decisions first-hand.
            </p>
          </div>
        </section>

        <section id="reflection" class="chapter" aria-labelledby="reflection-heading" data-chapter>
          <p class="eyebrow">Reflection</p>
          <h2 id="reflection-heading">What I took from the project</h2>
          <div class="copy">
            <p class="lead">
              Ignyte remains one of my clearest examples of end-to-end product ownership.
            </p>
            <p>
              I identified a business problem, proposed a product, helped establish its commercial
              model, led its development and remained accountable for its operation.
            </p>
            <p>
              The technical work mattered, but so did understanding what clients needed, deciding
              where to invest development effort and ensuring the product continued to work for the
              organisations using it.
            </p>
          </div>
        </section>
      </div>
    </div>

    <!-- ================= Skills and classification ================= -->
    <section id="skills" class="classification-band" aria-labelledby="skills-heading" data-chapter>
      <div class="container">
        <p class="eyebrow">At a glance</p>
        <ProjectClassification project={project} />
      </div>
    </section>

    <div class="container back">
      <a class="button button--outline" href="/work/">
        <span class="arrow arrow--back" aria-hidden="true">&larr;</span> Back to Selected work
      </a>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="related-heading">{related.length === 1 ? 'Related case study' : 'Related case studies'}</h2>
            <a class="text-link" href="/work/">
              View all work <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ul class="related-grid" role="list">
            {related.map((entry) => (
              <li>
                <ProjectCard project={entry} variant="compact" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Highlights the current chapter in "On this page". Purely an enhancement.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((link) => [
      link.hash.slice(1),
      link,
    ]),
  );
  const sections = document.querySelectorAll<HTMLElement>('[data-chapter]');

  if (links.size && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => link.removeAttribute('aria-current'));
          links.get(entry.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-block: 1.5rem clamp(2.5rem, 2rem + 3vw, 4.5rem);
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(232 107 85 / 0.18), transparent 60%),
      var(--color-deep);
    color: #fff;
  }

  .hero .breadcrumbs {
    color: #c3d6d4;
  }

  .hero .breadcrumbs a:hover {
    color: #fff;
  }

  .hero :focus-visible {
    outline-color: #fff;
  }

  .hero-grid {
    display: grid;
    align-items: center;
    gap: 2.5rem clamp(2rem, 1rem + 4vw, 4.5rem);
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.75rem);
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin-bottom: 1.1rem;
    color: #d6efec;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tags {
    column-gap: 1.5rem;
  }

  .tags span {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .tags span::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 1px;
    background: var(--color-coral);
  }

  .hero h1 {
    color: #fff;
    font-size: clamp(3.5rem, 2.2rem + 6vw, 6.75rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }

  .headline {
    max-width: 30rem;
    margin-top: 1.25rem;
    font-size: clamp(1.5rem, 1.25rem + 1.2vw, 2.125rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .hero-intro {
    max-width: 33rem;
    color: #e6f4f2;
    font-size: 1.125rem;
  }

  .hero-media :global(.media) {
    border-radius: calc(var(--radius) + 6px);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.35);
  }

  /* ---- Key highlights ----
     Mobile: one highlight per row, figure beside its label and context.
     Tablet: two by two.
     Desktop: four columns; subgrid keeps every figure, label and context on shared rows. */
  .facts {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .facts-grid {
    display: grid;
    gap: 0 clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .fact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 0.3rem;
    padding-block: 1rem 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .fact--outcome {
    border-top: 3px solid var(--color-coral);
  }

  .fact-figure {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
  }

  .fact-value {
    color: var(--color-deep);
    font-size: clamp(2.25rem, 1.9rem + 1.4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
  }

  .fact-unit {
    color: var(--color-coral-strong);
    font-size: 1rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .fact-label {
    color: var(--color-deep);
    font-weight: 700;
    line-height: 1.3;
  }

  .fact-context {
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  @media (max-width: 39.99rem) {
    .fact {
      grid-template-columns: 7.25rem minmax(0, 1fr);
      column-gap: 1rem;
    }

    .fact-figure {
      grid-row: span 2;
      flex-direction: column;
      align-items: flex-start;
    }

    .fact-value {
      font-size: 2rem;
    }

    .fact-label {
      padding-top: 0.2rem;
    }

    .fact:first-child {
      border-top-width: 3px;
    }
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .facts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .facts-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: auto auto auto;
    }

    .fact {
      grid-row: span 3;
      grid-template-rows: subgrid;
      gap: 0;
      padding-bottom: 0;
      border-top-width: 3px;
      border-top-color: var(--color-deep);
    }

    .fact--outcome {
