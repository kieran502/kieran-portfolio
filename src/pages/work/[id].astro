---
/**
 * The single reusable case-study route. One page is generated for every project
 * with `caseStudyReady: true`. Every optional section disappears when its field is empty,
 * so a short project does not leave gaps.
 */
import { Image } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ImpactStats from '../../components/ImpactStats.astro';
import ProjectTimeline from '../../components/ProjectTimeline.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import { getProjects, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter((project) => project.data.caseStudyReady)
    .map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());

const related = (await getEntries(data.relatedProjects)).filter(
  (entry) => import.meta.env.DEV || !entry.data.draft,
);

const kicker = data.kicker ?? [data.sector, data.capabilities[0]].filter(Boolean).join(' / ');

const facts = [
  { term: 'Sector', value: data.sector },
  { term: 'Client', value: data.clientDisplayName },
  { term: 'Capabilities', value: data.capabilities.join(', ') },
].filter((fact) => fact.value);

const hasChallenge = Boolean(data.challenge || data.challengePoints.length || data.approach);
const hasContribution = Boolean(data.role || data.contribution || data.contributionPoints.length);
const hasOutcomes = Boolean(data.outcomes || data.outcomePoints.length);
---

<BaseLayout
  title={`${data.title} case study`}
  description={data.seoDescription ?? data.summary}
  type="article"
  publishedTime={data.publishDate}
  wide
  sansHeadings
>
  <article>
    <header class="container case-header">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/work/">Selected work</a></li>
          <li aria-current="page">{data.title}</li>
        </ol>
      </nav>

      <div class="case-hero">
        <div class="case-intro">
          {kicker && <p class="eyebrow">{kicker}</p>}
          <h1>{data.title}</h1>
          <p class="headline">{data.headline ?? data.summary}</p>
          {
            data.intro && (
              <>
                <hr class="rule" />
                <p class="intro">{data.intro}</p>
              </>
            )
          }
        </div>
        <div class="case-media">
          <ProjectMedia
            project={project}
            ratio="thumb"
            sizes="(min-width: 60rem) 52vw, 100vw"
            eager
          />
        </div>
      </div>
    </header>

    {data.stats.length > 0 && <ImpactStats stats={data.stats} highlights={data.highlights} />}

    {
      data.overview && (
        <section class="container block" aria-labelledby="overview-heading">
          <div class:list={['overview', { 'overview--media': data.overviewImage }]}>
            <div class="overview-copy">
              <p class="eyebrow">Overview</p>
              <h2 id="overview-heading">What {data.title} was</h2>
              <div class="copy">
                <CopyBlock text={data.overview} />
              </div>
              {facts.length > 0 && (
                <dl class="facts">
                  {facts.map((fact) => (
                    <div>
                      <dt>{fact.term}</dt>
                      <dd>{fact.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
            {data.overviewImage && (
              <Image
                class="overview-image"
                src={data.overviewImage.src}
                alt={data.overviewImage.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 60rem) 55vw, 100vw"
              />
            )}
          </div>
        </section>
      )
    }

    {
      (hasChallenge || hasContribution) && (
        <section class="band">
          <div class:list={['container', 'split', { 'split--two': hasChallenge && hasContribution }]}>
            {hasChallenge && (
              <div class="challenge">
                <p class="eyebrow">The challenge</p>
                <h2>What had to work</h2>
                {data.challenge && (
                  <div class="copy">
                    <CopyBlock text={data.challenge} />
                  </div>
                )}
                {data.challengePoints.length > 0 && (
                  <ul class="points" role="list">
                    {data.challengePoints.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}
                {data.approach && (
                  <div class="approach">
                    <h3>The approach</h3>
                    <div class="copy">
                      <CopyBlock text={data.approach} />
                    </div>
                  </div>
                )}
              </div>
            )}
            {hasContribution && (
              <aside class="contribution" aria-labelledby="contribution-heading">
                <p class="eyebrow">My part</p>
                <h2 id="contribution-heading">My contribution</h2>
                {data.role && (
                  <div class="role copy">
                    <CopyBlock text={data.role} />
                  </div>
                )}
                {data.contribution && (
                  <div class="copy">
                    <CopyBlock text={data.contribution} />
                  </div>
                )}
                {data.contributionPoints.length > 0 && (
                  <ul class="checks" role="list">
                    {data.contributionPoints.map((point) => (
                      <li>
                        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                          <path
                            d="M4 10.5l4 4 8-9"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        {point}
                      </li>
                    ))}
                  </ul>
                )}
                {data.stats.length > 0 && (
                  <p class="separation">
                    This describes my own work. The commercial results on this page belong to the
                    product range and the wider business.
                  </p>
                )}
              </aside>
            )}
          </div>
        </section>
      )
    }

    {
      data.evolution.length > 0 && (
        <section class="container block" aria-labelledby="evolution-heading">
          <div class="block-head">
            <p class="eyebrow">Evolution</p>
            <h2 id="evolution-heading">How the platform evolved</h2>
          </div>
          <ProjectTimeline steps={data.evolution} />
        </section>
      )
    }

    {
      hasOutcomes && (
        <section class="container block block--flush" aria-labelledby="outcomes-heading">
          <div class="outcomes">
            <div class="outcomes-head">
              <p class="eyebrow">Results</p>
              <h2 id="outcomes-heading">Outcomes</h2>
              {data.outcomes && (
                <div class="copy">
                  <CopyBlock text={data.outcomes} />
                </div>
              )}
              {data.outcomeEvidence && <p class="evidence">{data.outcomeEvidence}</p>}
            </div>
            {data.outcomePoints.length > 0 && (
              <ul class="outcome-list" role="list">
                {data.outcomePoints.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            )}
          </div>
        </section>
      )
    }

    {
      data.gallery.length > 0 && (
        <section class="container block" aria-labelledby="gallery-heading">
          <div class="block-head">
            <p class="eyebrow">Gallery</p>
            <h2 id="gallery-heading">{data.title} in pictures</h2>
          </div>
          <ProjectGallery items={data.gallery} />
        </section>
      )
    }

    {
      data.video && (
        <section class="container block" aria-labelledby="video-heading">
          <h2 id="video-heading">Video</h2>
          <p class="video-link">
            <a class="text-link" href={data.video.url} rel="noopener">
              Watch: {data.video.title} <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </section>
      )
    }

    {
      hasBody && (
        <div class="container block">
          <div class="prose">
            <Content />
          </div>
        </div>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="related-heading">Related projects</h2>
            <a class="text-link" href="/work/">
              View all work <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ul class="related-grid" role="list">
            {related.map((entry) => (
              <li>
                <ProjectCard project={entry} variant="compact" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---- Header ---- */
  .case-header {
    padding-top: 1.5rem;
  }

  .case-hero {
    display: grid;
    align-items: center;
    gap: 2rem clamp(2rem, 1rem + 4vw, 4.5rem);
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.75rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  @media (min-width: 60rem) {
    .case-hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .case-intro h1 {
    font-size: clamp(3.5rem, 2.2rem + 6vw, 6.75rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }

  .headline {
    max-width: 30rem;
    margin-top: 1.25rem;
    color: var(--color-deep);
    font-size: clamp(1.5rem, 1.25rem + 1.2vw, 2.125rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .intro {
    max-width: 33rem;
    font-size: 1.125rem;
  }

  .case-media :global(.media),
  .case-media :global(.ph) {
    border-radius: calc(var(--radius) + 6px);
  }

  /* ---- Shared section rhythm ---- */
  .block {
    padding-block: var(--space-section);
  }

  .block + .block,
  .block--flush {
    padding-top: 0;
  }

  .block-head {
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  h2 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    line-height: 1.05;
  }

  .copy {
    margin-top: 1.25rem;
    max-width: 36rem;
    font-size: 1.125rem;
  }

  .copy :global(p + p) {
    margin-top: 1rem;
  }

  /* ---- Overview ---- */
  .overview {
    display: grid;
    align-items: center;
    gap: 2.5rem clamp(2rem, 1rem + 4vw, 4.5rem);
  }

  @media (min-width: 60rem) {
    .overview--media {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .overview-image {
    width: 100%;
    border-radius: calc(var(--radius) + 6px);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .facts dt {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0.2rem 0 0;
    color: var(--color-deep);
    font-weight: 600;
  }

  /* ---- Challenge and contribution ---- */
  .band {
    padding-block: var(--space-section);
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .split {
    display: grid;
    align-items: start;
    gap: 3rem clamp(2rem, 1rem + 4vw, 4.5rem);
  }

  @media (min-width: 60rem) {
    .split--two {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }

    .challenge {
      padding-top: clamp(1.5rem, 1rem + 1.6vw, 2.75rem);
    }
  }

  .points {
    display: grid;
    margin-top: 1.75rem;
    max-width: 36rem;
  }

  .points li {
    position: relative;
    padding: 0.9rem 0 0.9rem 1.75rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-deep);
    font-weight: 550;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.55rem;
    width: 0.9rem;
    height: 3px;
    border-radius: 2px;
    background: var(--color-coral);
  }

  .approach {
    margin-top: 2.5rem;
  }

  .contribution {
    padding: clamp(1.5rem, 1rem + 1.6vw, 2.75rem);
    border-radius: calc(var(--radius) + 6px);
    background: var(--color-coral-soft);
  }

  .contribution .eyebrow {
    color: #a53d29;
  }

  .contribution .copy {
    color: var(--color-deep);
  }

  .checks {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 40rem) {
    .checks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .checks li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.72);
    color: var(--color-deep);
    font-weight: 600;
    line-height: 1.35;
  }

  .checks svg {
    flex: none;
    margin-top: 0.1rem;
    color: #a53d29;
  }

  .separation {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(24 60 64 / 0.18);
    color: #4c5f6e;
    font-size: 0.9688rem;
  }

  /* ---- Outcomes ---- */
  .outcomes {
    display: grid;
    align-items: center;
    gap: 2rem clamp(2rem, 1rem + 4vw, 4.5rem);
    padding: clamp(1.75rem, 1rem + 3vw, 4rem);
    border-radius: calc(var(--radius) + 6px);
    background: var(--color-teal);
    color: #fff;
  }

  @media (min-width: 60rem) {
    .outcomes {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    }
  }

  .outcomes h2 {
    color: #fff;
  }

  .outcomes .eyebrow {
    color: #d6efec;
  }

  .evidence {
    max-width: 26rem;
    margin-top: 1.25rem;
    color: #e6f4f2;
    font-size: 0.9688rem;
  }

  .outcome-list {
    display: grid;
    gap: 0 2rem;
  }

  @media (min-width: 40rem) {
    .outcome-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .outcome-list li {
    padding-block: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.35);
    font-size: clamp(1.125rem, 1.05rem + 0.4vw, 1.3125rem);
    font-weight: 650;
    line-height: 1.3;
  }

  .outcomes :global(:focus-visible) {
    outline-color: #fff;
  }

  .video-link {
    margin-top: 1rem;
  }

  /* ---- Related ---- */
  .related {
    /* Sits flush against the footer (cancels the footer's top margin). */
    margin-bottom: calc(var(--space-section) * -1);
    padding-block: var(--space-section);
    border-top: 1px solid var(--color-border);
    background: var(--color-sand);
  }

  .related-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 40rem) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .related-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
