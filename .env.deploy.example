# Copy this file to ".env.deploy" and fill it in. ".env.deploy" is ignored by git,
# so the password never enters the repository. Do not paste these values into chat.

# FTP server name. In cPanel: Files > FTP Accounts > Configure FTP Client.
# Use the server name shown there (the one the security certificate is issued for).
DEPLOY_HOST=

# Port for FTPS (explicit TLS). Normally 21.
DEPLOY_PORT=21

# A dedicated FTP account restricted to the preview folder only (recommended),
# e.g. preview@yourdomain.co.uk
DEPLOY_USER=
DEPLOY_PASSWORD=

# Folder to upload into, as that FTP account sees it. For an account restricted
# to the preview folder this is simply "/".
DEPLOY_REMOTE_DIR=/

# The public address of the preview, including https://
DEPLOY_URL=

# ---- Netlify (alternative preview host that AI readers such as ChatGPT can open) ----
# Personal access token: Netlify > User settings > Applications > New access token
NETLIFY_AUTH_TOKEN=
# Site ID: Netlify > your site > Site configuration > Site details > Site ID
NETLIFY_SITE_ID=
# The site address, e.g. https://your-site-name.netlify.app/
NETLIFY_URL=
